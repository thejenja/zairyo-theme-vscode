	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#A08C90", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": { "foreground": "#FFB1C8", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": { "foreground": "#FFB39A" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#E1B1E3" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.class"],
			"settings": { "foreground": "#E5BDC7" }
		},
		{
			"name": "Variables",
			"scope": ["variable"],
			"settings": { "foreground": "#ECE0E1" }
		},
		{
			"name": "Constants",
			"scope": ["constant", "variable.other.constant"],
			"settings": { "foreground": "#FFB1C8" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#D7C1C5" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#FFB1C8" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#E5BDC7" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#D7C1C5" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#FFB4AB", "fontStyle": "underline" }
		}
	]
}
