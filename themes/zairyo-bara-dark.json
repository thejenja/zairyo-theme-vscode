	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#A08C90", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#FFB1C8", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string.quoted",
				"string.unquoted",
				"string.template"
			],
			"settings": { "foreground": "#FFB39A" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"entity.name.function.python"
			],
			"settings": { "foreground": "#E5BDC7" }
		},
		{
			"name": "Types & Classes",
			"scope": [
				"entity.name.type",
				"support.type",
				"entity.name.class",
				"support.class"
			],
			"settings": { "foreground": "#FADBE2" }
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"variable.other",
				"variable.language.self.python",
				"variable.language.this.js",
				"variable.object",
				"support.variable.property"
			],
			"settings": { "foreground": "#ECE0E1" }
		},
		{
			"name": "Constants",
			"scope": ["constant", "constant.language", "variable.other.constant"],
