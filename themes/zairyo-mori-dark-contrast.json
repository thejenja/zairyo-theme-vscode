	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#C2C9BD", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": { "foreground": "#88D890", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": { "foreground": "#E6C470" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#A0CFD5" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.type", "entity.name.class"],
			"settings": { "foreground": "#B8CCB5", "fontStyle": "bold" }
		},
		{
			"name": "Variables",
			"scope": ["variable"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Constants",
			"scope": ["constant"],
			"settings": { "foreground": "#88D890" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#E2E3DD" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#88D890" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#A0CFD5" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#C2C9BD" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#FFB4AB", "fontStyle": "underline bold" }
		},
		{
			"name": "Markup Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#88D890", "fontStyle": "bold" }
		},
		{
			"name": "Markup Links",
			"scope": ["markup.underline.link"],
			"settings": { "foreground": "#A0CFD5" }
		},
		{
			"name": "Semantic Classes",
			"scope": ["class", "interface", "enum"],
			"settings": { "foreground": "#B8CCB5" }
		}
	]
}
