	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#8C9388", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#88D890", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string.quoted",
				"string.unquoted",
				"string.template"
			],
			"settings": { "foreground": "#E6C470" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": { "foreground": "#A0CFD5" }
		},
		{
			"name": "Types & Classes",
			"scope": [
				"entity.name.type",
				"support.type",
				"entity.name.class",
				"support.class"
			],
			"settings": { "foreground": "#B8CCB5" }
		},
		{
			"name": "Variables",
