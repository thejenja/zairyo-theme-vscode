	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#857376", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#B02B63", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
