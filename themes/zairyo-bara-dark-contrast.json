	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#D7C1C5", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": { "foreground": "#FFB1C8", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": { "foreground": "#FFB39A" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#E1B1E3" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.type", "entity.name.class"],
			"settings": { "foreground": "#E5BDC7", "fontStyle": "bold" }
		},
		{
			"name": "Variables",
			"scope": ["variable"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Constants",
			"scope": ["constant"],
			"settings": { "foreground": "#FFB1C8" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#ECE0E1" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#FFB1C8" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#E5BDC7" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#D7C1C5" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#FFB4AB", "fontStyle": "underline bold" }
		},
		{
			"name": "Markup Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#FFB1C8", "fontStyle": "bold" }
		},
		{
			"name": "Markup Links",
			"scope": ["markup.underline.link"],
			"settings": { "foreground": "#E5BDC7" }
		},
		{
			"name": "Semantic Classes",
			"scope": ["class", "interface", "enum"],
			"settings": { "foreground": "#E5BDC7" }
		}
	]
}
