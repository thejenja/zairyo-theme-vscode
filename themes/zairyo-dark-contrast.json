	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#CAC4CF", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#D0BCFF", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.unquoted"],
			"settings": { "foreground": "#EFB8C8" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": { "foreground": "#EADDFF" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.type", "storage.type"],
			"settings": { "foreground": "#EADDFF" }
		},
		{
			"name": "Classes",
			"scope": ["entity.name.class", "support.class"],
			"settings": { "foreground": "#EADDFF" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Constants",
			"scope": ["constant", "constant.language", "variable.other.constant"],
			"settings": { "foreground": "#D0BCFF" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#E6E1E5" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": { "foreground": "#D0BCFF" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#EADDFF" }
		},
		{
			"name": "Properties",
			"scope": ["variable.object", "support.variable.property"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#E6E1E5" }
		},
		{
			"name": "Markup Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#D0BCFF", "fontStyle": "bold" }
		},
		{
			"name": "Markup Bold",
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"name": "Markup Italic",
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"name": "Markup Links",
