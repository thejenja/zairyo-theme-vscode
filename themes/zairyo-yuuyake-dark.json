	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment"],
			"settings": { "foreground": "#A08D87", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage.type", "keyword.control"],
			"settings": { "foreground": "#FFB59A", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": { "foreground": "#FFB39A" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#E6C289" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.class"],
			"settings": { "foreground": "#D8C2FF" }
		},
		{
			"name": "Variables",
			"scope": ["variable"],
			"settings": { "foreground": "#EAE0D4" }
		},
		{
			"name": "Constants",
			"scope": ["constant"],
			"settings": { "foreground": "#FFB59A" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#D2C4B5" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#FFB59A" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#D8C2FF" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#D2C4B5" }
		}
	]
}
