	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#BEC8C8", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": { "foreground": "#4CD9E0", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": { "foreground": "#E0C988" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#B8CBEB" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.type", "entity.name.class"],
			"settings": { "foreground": "#A0D0D4", "fontStyle": "bold" }
		},
		{
			"name": "Variables",
			"scope": ["variable"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"name": "Constants",
			"scope": ["constant"],
			"settings": { "foreground": "#4CD9E0" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#DEE4E4" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#4CD9E0" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#B1CBCB" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#BEC8C8" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#FFB4AB", "fontStyle": "underline bold" }
		},
		{
			"name": "Markup Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#4CD9E0", "fontStyle": "bold" }
		},
		{
			"name": "Markup Links",
			"scope": ["markup.underline.link"],
			"settings": { "foreground": "#B1CBCB" }
		},
		{
			"name": "Semantic Classes",
			"scope": ["class", "interface", "enum"],
			"settings": { "foreground": "#A0D0D4" }
		}
	]
}
