	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#899393", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#4CD9E0", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.unquoted"],
			"settings": { "foreground": "#E0C988" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": { "foreground": "#B1CBCB" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.type", "storage.type"],
			"settings": { "foreground": "#A0D0D4" }
