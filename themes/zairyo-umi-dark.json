	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment"],
			"settings": { "foreground": "#899393", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage.type"],
			"settings": { "foreground": "#4CD9E0", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": { "foreground": "#E0C988" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#B8CBEB" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.class"],
			"settings": { "foreground": "#A0D0D4" }
		},
		{
			"name": "Variables",
			"scope": ["variable"],
			"settings": { "foreground": "#DEE4E4" }
		},
		{
			"name": "Constants",
			"scope": ["constant"],
			"settings": { "foreground": "#80E0E2" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#BEC8C8" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#4CD9E0" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#B1CBCB" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#BEC8C8" }
		}
	]
}
