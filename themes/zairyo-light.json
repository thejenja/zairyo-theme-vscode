	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#79747E", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#6750A4", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.unquoted"],
			"settings": { "foreground": "#7D5260" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#BA1A1A" }
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": { "foreground": "#625B71" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.type", "storage.type"],
			"settings": { "foreground": "#625B71" }
		},
		{
			"name": "Classes",
			"scope": ["entity.name.class", "support.class"],
			"settings": { "foreground": "#625B71" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other"],
			"settings": { "foreground": "#1D1B20" }
		},
		{
			"name": "Constants",
			"scope": ["constant", "constant.language", "variable.other.constant"],
			"settings": { "foreground": "#6750A4" }
		},
		{
			"name": "Operators",
