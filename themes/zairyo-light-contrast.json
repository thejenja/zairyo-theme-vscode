	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#49454F", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#4F378B", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.unquoted"],
			"settings": { "foreground": "#4E2634" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#8C1D18" }
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": { "foreground": "#4A4458" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.type", "storage.type"],
			"settings": { "foreground": "#4A4458" }
		},
		{
			"name": "Classes",
			"scope": ["entity.name.class", "support.class"],
			"settings": { "foreground": "#4A4458" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other"],
			"settings": { "foreground": "#000000" }
		},
		{
			"name": "Constants",
			"scope": ["constant", "constant.language", "variable.other.constant"],
			"settings": { "foreground": "#4F378B" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#49454F" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": { "foreground": "#4F378B" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#4A4458" }
		},
		{
			"name": "Properties",
			"scope": ["variable.object", "support.variable.property"],
			"settings": { "foreground": "#000000" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#49454F" }
		},
		{
			"name": "Markup Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#4F378B", "fontStyle": "bold" }
		},
		{
			"name": "Markup Bold",
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"name": "Markup Italic",
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"name": "Markup Links",
			"scope": ["markup.underline.link"],
			"settings": { "foreground": "#4A4458" }
		},
		{
			"name": "Markup Code",
			"scope": ["markup.inline.raw"],
			"settings": { "foreground": "#4E2634" }
		},
		{
			"name": "Diff Inserted",
