	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment"],
			"settings": { "foreground": "#8C9388", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage.type"],
			"settings": { "foreground": "#88D890", "fontStyle": "bold" }
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": { "foreground": "#E6C470" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#FFB4AB" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#A0CFD5" }
		},
		{
			"name": "Types",
			"scope": ["entity.name.type", "support.class"],
			"settings": { "foreground": "#B8CCB5" }
		},
		{
			"name": "Variables",
			"scope": ["variable"],
			"settings": { "foreground": "#E2E3DD" }
		},
		{
			"name": "Constants",
			"scope": ["constant"],
			"settings": { "foreground": "#81D5C9" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#C2C9BD" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#88D890" }
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#A0CFD5" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#C2C9BD" }
		}
	]
}
